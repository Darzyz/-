<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="12週減脂保肌" />
  <meta name="theme-color" content="#121214" />
  <title>12週微赤字減脂保肌追蹤器</title>

  <!-- Google Fonts: Inter & JetBrains Mono for crisp numbers -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'PingFang TC', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            bgMain: '#121214',
            bgCard: '#1C1C1F',
            bgElevated: '#26262B',
            accent: '#E07A5F',      // Brick Orange / Caramel
            accentLight: '#F4A261', // Warm Amber
            sage: '#52B788',        // Muscle Safe Green
            borderSubtle: '#2E2E34'
          }
        }
      }
    }
  </script>

  <!-- Custom App Icon for iOS Home Screen (Data URI SVG) -->
  <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%231C1C1F%22/><circle cx=%2250%22 cy=%2250%22 r=%2236%22 fill=%22none%22 stroke=%22%23E07A5F%22 stroke-width=%228%22/><text x=%2250%22 y=%2258%22 font-size=%2226%22 font-family=%22sans-serif%22 font-weight=%22bold%22 fill=%22%23F4F4F6%22 text-anchor=%22middle%22>-19%25</text></svg>" />

  <style>
    body {
      background-color: #121214;
      color: #F4F4F6;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      overscroll-behavior-y: none;
    }
    .safe-top {
      padding-top: max(1rem, env(safe-area-inset-top));
    }
    .safe-bottom {
      padding-bottom: max(5.5rem, calc(env(safe-area-inset-bottom) + 4.5rem));
    }
    .nav-safe-bottom {
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
    }
    /* Custom scrollbar hiding for clean iOS look */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    @keyframes pulse-subtle {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.02); }
    }
    .animate-pop {
      animation: pulse-subtle 0.25s ease-out;
    }
  </style>
</head>
<body class="antialiased selection:bg-accent selection:text-white">

  <!-- Main App Container (iPhone Viewport Max-Width) -->
  <div id="app" class="max-w-md mx-auto min-h-screen bg-bgMain relative flex flex-col justify-between shadow-2xl border-x border-borderSubtle/40">
    
    <!-- Top Header & Global Progress -->
    <header class="safe-top px-4 pb-3 bg-bgMain/90 backdrop-blur-md sticky top-0 z-30 border-b border-borderSubtle">
      <div class="flex items-center justify-between mb-2">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 text-[11px] font-bold tracking-wider uppercase rounded bg-accent/20 text-accent border border-accent/30" id="header-week-badge">WEEK 1 / 12</span>
            <span class="text-xs text-zinc-400 font-medium">FFMI 19.3 保肌減脂計畫</span>
          </div>
          <h1 class="text-lg font-extrabold tracking-tight text-white mt-0.5">微赤字控制中心</h1>
        </div>
        <button onclick="openStartDateModal()" class="text-right group bg-bgCard hover:bg-bgElevated px-3 py-1.5 rounded-xl border border-borderSubtle transition">
          <div class="text-[10px] text-zinc-400">累積減去純脂肪預估</div>
          <div class="text-sm font-mono font-bold text-accentLight flex items-center justify-end gap-1">
            <span id="header-fat-lost">0.00</span> <span class="text-xs font-normal text-zinc-400">kg</span>
            <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
        </button>
      </div>

      <!-- 12-Week Total Deficit Progress Bar -->
      <div class="bg-bgCard rounded-xl p-2.5 border border-borderSubtle">
        <div class="flex justify-between text-xs mb-1">
          <span class="text-zinc-400">12週總熱量赤字進度 <span class="text-zinc-500">(目標 21,000 kcal)</span></span>
          <span class="font-mono font-semibold text-zinc-200"><span id="header-total-kcal">0</span> kcal <span class="text-zinc-500">(<span id="header-total-pts">0.0</span>/84點)</span></span>
        </div>
        <div class="w-full h-2 bg-zinc-800 rounded-full overflow-hidden">
          <div id="header-total-bar" class="h-full bg-gradient-to-r from-accent to-accentLight transition-all duration-500 rounded-full" style="width: 0%"></div>
        </div>
      </div>
    </header>

    <!-- Main Scrollable Content Area -->
    <main class="flex-1 px-4 pt-3 safe-bottom overflow-y-auto">
      
      <!-- ================= TAB 1: 今日打卡 (DAILY KPI & JACKPOT) ================= -->
      <section id="tab-daily" class="space-y-4">
        
        <!-- Weekly Score Card & Smart Bank -->
        <div class="bg-gradient-to-br from-bgCard to-bgElevated rounded-2xl p-4 border border-borderSubtle shadow-lg relative overflow-hidden">
          <div class="flex justify-between items-start mb-3">
            <div>
              <span class="text-xs font-medium text-zinc-400">本週積分進度 (每週目標 7.0 點)</span>
              <div class="flex items-baseline gap-2 mt-0.5">
                <span id="weekly-pts-display" class="text-3xl font-mono font-extrabold text-white">0.0</span>
                <span class="text-sm font-mono text-zinc-400">/ 7.0 pts</span>
                <span id="weekly-kcal-display" class="text-xs font-mono text-accentLight ml-1">(-0 kcal)</span>
              </div>
            </div>
            <div id="weekly-status-badge" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-zinc-800 text-zinc-300 border border-zinc-700">
              累積中
            </div>
          </div>

          <!-- Weekly Progress Bar -->
          <div class="w-full h-3 bg-zinc-900 rounded-full overflow-hidden p-0.5 border border-zinc-800 mb-3">
            <div id="weekly-pts-bar" class="h-full bg-gradient-to-r from-accent via-accentLight to-sage rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>

          <!-- Smart Bank / Relief Message -->
          <div id="smart-bank-box" class="bg-zinc-900/70 rounded-xl p-2.5 border border-zinc-800/80 flex items-start gap-2.5 text-xs text-zinc-300">
            <span class="text-base leading-none mt-0.5">💡</span>
            <p id="smart-bank-text" class="leading-relaxed">
              每天完成「步數+減半碗飯」即得 1 點。若外食改吃波奇碗可直接賺 +1.5 點加速或折抵週末聚餐！
            </p>
          </div>
        </div>

        <!-- 7-Day Quick Date Selector Strip -->
        <div class="bg-bgCard rounded-2xl p-2.5 border border-borderSubtle">
          <div class="flex items-center justify-between mb-2 px-1">
            <button onclick="shiftDate(-1)" class="p-1 text-zinc-400 hover:text-white rounded-lg bg-zinc-800/60">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <div class="flex items-center gap-2">
              <span id="selected-date-label" class="text-xs font-bold text-zinc-200">今天 (2025-05-01)</span>
              <button onclick="selectToday()" id="btn-back-today" class="hidden text-[11px] px-2 py-0.5 rounded bg-accent/20 text-accent font-semibold">回今天</button>
            </div>
            <button onclick="shiftDate(1)" class="p-1 text-zinc-400 hover:text-white rounded-lg bg-zinc-800/60">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
          <div id="week-day-strip" class="grid grid-cols-7 gap-1 text-center">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- SECTION 1: 每日基礎微調 KPI (1.0 pt total) -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between px-1">
            <h2 class="text-sm font-bold text-zinc-200 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              每日基礎 KPI（無腦基本盤）
            </h2>
            <span id="daily-base-status" class="text-xs font-mono text-zinc-400">今日已得 0.0 / 1.0 pt</span>
          </div>

          <!-- Step KPI Card -->
          <button onclick="toggleDailyFlag('steps')" id="card-kpi-steps" class="w-full text-left bg-bgCard hover:bg-bgElevated active:scale-[0.99] transition-all rounded-2xl p-3.5 border border-borderSubtle flex items-center justify-between group">
            <div class="flex items-center gap-3.5">
              <div id="icon-kpi-steps" class="w-11 h-11 rounded-xl bg-zinc-800 flex items-center justify-center text-xl border border-zinc-700 transition-colors">
                🚶‍♂️
              </div>
              <div>
                <div class="font-bold text-sm text-zinc-100 flex items-center gap-2">
                  日常步數 +3,000 步
                  <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-zinc-800 text-accentLight border border-zinc-700">+0.45 pt</span>
                </div>
                <p class="text-xs text-zinc-400 mt-0.5">約快走 22 分鐘，或全日總步數達 8,500 步 (-110 kcal)</p>
              </div>
            </div>
            <div id="check-kpi-steps" class="w-6 h-6 rounded-full border-2 border-zinc-600 flex items-center justify-center transition-all">
              <svg class="w-3.5 h-3.5 text-white opacity-0 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
          </button>

          <!-- Lunch Rice KPI Card -->
          <button onclick="toggleDailyFlag('rice')" id="card-kpi-rice" class="w-full text-left bg-bgCard hover:bg-bgElevated active:scale-[0.99] transition-all rounded-2xl p-3.5 border border-borderSubtle flex items-center justify-between group">
            <div class="flex items-center gap-3.5">
              <div id="icon-kpi-rice" class="w-11 h-11 rounded-xl bg-zinc-800 flex items-center justify-center text-xl border border-zinc-700 transition-colors">
                🍚
              </div>
              <div>
                <div class="font-bold text-sm text-zinc-100 flex items-center gap-2">
                  午餐少吃 1/2 碗白飯
                  <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-zinc-800 text-accentLight border border-zinc-700">+0.55 pt</span>
                </div>
                <p class="text-xs text-zinc-400 mt-0.5">便當飯撥掉一半 (-100g ≈ -140 kcal)，晚餐練後正常吃</p>
              </div>
            </div>
            <div id="check-kpi-rice" class="w-6 h-6 rounded-full border-2 border-zinc-600 flex items-center justify-center transition-all">
              <svg class="w-3.5 h-3.5 text-white opacity-0 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
          </button>
        </div>

        <!-- SECTION 2: 健康飲食替換爆擊 (Calorie Jackpot) -->
        <div class="space-y-2.5 pt-1">
          <div class="flex items-center justify-between px-1">
            <h2 class="text-sm font-bold text-zinc-200 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-accentLight"></span>
              飲食替換爆擊（加速 / 賺免死金牌）
            </h2>
            <span class="text-[11px] text-zinc-400">可點擊累加次數</span>
          </div>

          <div class="grid grid-cols-1 gap-2.5">
            <!-- Swap 1: Poke Bowl -->
            <div class="bg-bgCard rounded-2xl p-3.5 border border-borderSubtle flex items-center justify-between">
              <div class="flex items-center gap-3 pr-2">
                <div class="w-10 h-10 rounded-xl bg-accent/15 border border-accent/30 flex items-center justify-center text-lg shrink-0">
                  🥗
                </div>
                <div>
                  <div class="font-bold text-sm text-zinc-100 flex items-center gap-1.5 flex-wrap">
                    <span>拉麵/麥當勞 ➔ 改吃波奇碗</span>
                    <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-accent/20 text-accent font-bold">+1.5 pts</span>
                  </div>
                  <p class="text-xs text-zinc-400 mt-0.5">單次立省 ~400 kcal！直接抵 3 頓減半碗白飯</p>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button onclick="updateSwapCount('poke', -1)" class="w-7 h-7 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono font-bold flex items-center justify-center border border-zinc-700">-</button>
                <span id="count-swap-poke" class="w-5 text-center font-mono font-bold text-sm text-white">0</span>
                <button onclick="updateSwapCount('poke', 1)" class="w-7 h-7 rounded-lg bg-accent hover:bg-accentLight text-white font-mono font-bold flex items-center justify-center shadow">+</button>
              </div>
            </div>

            <!-- Swap 2: Bento Swap -->
            <div class="bg-bgCard rounded-2xl p-3.5 border border-borderSubtle flex items-center justify-between">
              <div class="flex items-center gap-3 pr-2">
                <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-lg shrink-0">
                  🍱
                </div>
                <div>
                  <div class="font-bold text-sm text-zinc-100 flex items-center gap-1.5 flex-wrap">
                    <span>炸物便當 ➔ 改滷雞腿/烤魚</span>
                    <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold">+1.2 pts</span>
                  </div>
                  <p class="text-xs text-zinc-400 mt-0.5">去炸皮改原型肉類，省下 ~300 kcal 劣質油脂</p>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button onclick="updateSwapCount('bento', -1)" class="w-7 h-7 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono font-bold flex items-center justify-center border border-zinc-700">-</button>
                <span id="count-swap-bento" class="w-5 text-center font-mono font-bold text-sm text-white">0</span>
                <button onclick="updateSwapCount('bento', 1)" class="w-7 h-7 rounded-lg bg-accent hover:bg-accentLight text-white font-mono font-bold flex items-center justify-center shadow">+</button>
              </div>
            </div>

            <!-- Swap 3: Drink / Extra Cardio -->
            <div class="bg-bgCard rounded-2xl p-3.5 border border-borderSubtle flex items-center justify-between">
              <div class="flex items-center gap-3 pr-2">
                <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-lg shrink-0">
                  🍵
                </div>
                <div>
                  <div class="font-bold text-sm text-zinc-100 flex items-center gap-1.5 flex-wrap">
                    <span>含糖飲改無糖 / 坡度快走15分</span>
                    <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold">+0.5 pt</span>
                  </div>
                  <p class="text-xs text-zinc-400 mt-0.5">飲料改美式/無糖茶，或練後多走 15 分鐘 (-125 kcal)</p>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button onclick="updateSwapCount('drink', -1)" class="w-7 h-7 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-mono font-bold flex items-center justify-center border border-zinc-700">-</button>
                <span id="count-swap-drink" class="w-5 text-center font-mono font-bold text-sm text-white">0</span>
                <button onclick="updateSwapCount('drink', 1)" class="w-7 h-7 rounded-lg bg-accent hover:bg-accentLight text-white font-mono font-bold flex items-center justify-center shadow">+</button>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 3: 保肌防線確認 (Muscle Retention Shield) -->
        <div class="space-y-2.5 pt-1">
          <div class="flex items-center justify-between px-1">
            <h2 class="text-sm font-bold text-zinc-200 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-sage"></span>
              保肌防線（鎖住 53.1kg 除脂體重）
            </h2>
            <span class="text-[11px] text-sage font-medium">不計熱量・決定體態線條</span>
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <button onclick="toggleDailyFlag('workout')" id="card-shield-workout" class="p-3 rounded-2xl bg-bgCard border border-borderSubtle text-left transition-all flex flex-col justify-between h-24">
              <div class="flex justify-between items-start w-full">
                <span class="text-xl">🏋️‍♂️</span>
                <div id="dot-shield-workout" class="w-4 h-4 rounded-full border border-zinc-600 flex items-center justify-center"></div>
              </div>
              <div>
                <div class="text-xs font-bold text-zinc-100">完成重訓不降重</div>
                <div class="text-[10px] text-zinc-400 mt-0.5">維持主項力量刺激</div>
              </div>
            </button>

            <button onclick="toggleDailyFlag('protein')" id="card-shield-protein" class="p-3 rounded-2xl bg-bgCard border border-borderSubtle text-left transition-all flex flex-col justify-between h-24">
              <div class="flex justify-between items-start w-full">
                <span class="text-xl">🥛</span>
                <div id="dot-shield-protein" class="w-4 h-4 rounded-full border border-zinc-600 flex items-center justify-center"></div>
              </div>
              <div>
                <div class="text-xs font-bold text-zinc-100">練後乳清+堅果</div>
                <div class="text-[10px] text-zinc-400 mt-0.5">蛋白質達標 125g+</div>
              </div>
            </button>
          </div>
        </div>

      </section>

      <!-- ================= TAB 2: 體態趨勢 (BODY STATS & LBM GUARD) ================= -->
      <section id="tab-stats" class="space-y-4 hidden">
        
        <!-- LBM Guardrail Status Banner -->
        <div id="lbm-alert-card" class="bg-bgCard rounded-2xl p-4 border border-sage/40 shadow-lg">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-sage flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-sage animate-ping"></span>
              除脂體重 (LBM) 保肌監測防線
            </span>
            <span class="text-xs font-mono text-zinc-400">底線目標 ≥ 53.0 kg</span>
          </div>
          <div class="grid grid-cols-3 gap-2 pt-1">
            <div class="bg-zinc-900/80 p-2.5 rounded-xl border border-zinc-800">
              <div class="text-[10px] text-zinc-400">最新除脂體重</div>
              <div id="stat-current-lbm" class="text-lg font-mono font-bold text-white mt-0.5">53.1 <span class="text-xs font-normal text-zinc-400">kg</span></div>
            </div>
            <div class="bg-zinc-900/80 p-2.5 rounded-xl border border-zinc-800">
              <div class="text-[10px] text-zinc-400">最新純脂肪重</div>
              <div id="stat-current-fatmass" class="text-lg font-mono font-bold text-accentLight mt-0.5">15.3 <span class="text-xs font-normal text-zinc-400">kg</span></div>
            </div>
            <div class="bg-zinc-900/80 p-2.5 rounded-xl border border-zinc-800">
              <div class="text-[10px] text-zinc-400">7日平均體重</div>
              <div id="stat-moving-avg" class="text-lg font-mono font-bold text-zinc-200 mt-0.5">68.4 <span class="text-xs font-normal text-zinc-400">kg</span></div>
            </div>
          </div>
          <p id="lbm-feedback-text" class="text-xs text-zinc-300 mt-2.5 leading-relaxed">
            目前除脂體重維持在 53.1 kg（FFMI 19.3），肌肉量保留完美！請持續維持重訓重量。
          </p>
        </div>

        <!-- Milestone Progress Comparison (Week 0 -> Week 12) -->
        <div class="bg-bgCard rounded-2xl p-4 border border-borderSubtle space-y-3">
