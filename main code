  <!-- Application Logic -->
  <script>
    const STORAGE_KEY = 'microcut_12w_tracker_v1';

    // Default User Baseline from Prompt
    const BASELINE = {
      height: 166,
      startWeight: 68.4,
      targetWeight: 65.7,
      startBF: 22.4,
      targetBF: 18.8,
      startWaist: 77.0,
      targetWaist: 73.5,
      lbmFloor: 53.0
    };

    // Format Date as YYYY-MM-DD in local timezone
    function formatDateStr(dateObj) {
      const y = dateObj.getFullYear();
      const m = String(dateObj.getMonth() + 1).padStart(2, '0');
      const d = String(dateObj.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    const todayStr = formatDateStr(new Date());
    let selectedDateStr = todayStr;

    // App State
    let state = {
      startDate: todayStr,
      dailyLogs: {}, // { 'YYYY-MM-DD': { steps: false, rice: false, poke: 0, bento: 0, drink: 0, workout: false, protein: false } }
      bodyLogs: [
        { date: todayStr, weight: 68.4, bf: 22.4, waist: 77.0 }
      ]
    };

    // Load from localStorage
    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          state = { ...state, ...parsed };
          if (!state.bodyLogs || state.bodyLogs.length === 0) {
            state.bodyLogs = [{ date: state.startDate, weight: 68.4, bf: 22.4, waist: 77.0 }];
          }
        } else {
          saveState();
        }
      } catch (e) {
        console.error('Failed to load state:', e);
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {
        console.error('Failed to save state:', e);
      }
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.remove('opacity-0');
      setTimeout(() => t.classList.add('opacity-0'), 1800);
    }

    // Calculate points for a single day log
    function calcDayPoints(log) {
      if (!log) return 0;
      let pts = 0;
      if (log.steps) pts += 0.45;
      if (log.rice) pts += 0.55;
      pts += (log.poke || 0) * 1.5;
      pts += (log.bento || 0) * 1.2;
      pts += (log.drink || 0) * 0.5;
      return Math.round(pts * 100) / 100;
    }

    // Get Monday of the week for a given YYYY-MM-DD
    function getMondayOfWeek(dateStr) {
      const [y, m, d] = dateStr.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      const day = dt.getDay(); // 0 is Sun, 1 is Mon
      const diff = dt.getDate() - day + (day === 0 ? -6 : 1);
      return new Date(dt.setDate(diff));
    }

    // Get all 7 date strings (Mon-Sun) for the week containing dateStr
    function getWeekDateStrings(dateStr) {
      const mon = getMondayOfWeek(dateStr);
      const list = [];
      for (let i = 0; i < 7; i++) {
        const temp = new Date(mon);
        temp.setDate(mon.getDate() + i);
        list.push(formatDateStr(temp));
      }
      return list;
    }

    // Ensure day log object exists
    function getDayLog(dateStr) {
      if (!state.dailyLogs[dateStr]) {
        state.dailyLogs[dateStr] = {
          steps: false,
          rice: false,
          poke: 0,
          bento: 0,
          drink: 0,
          workout: false,
          protein: false
        };
      }
      return state.dailyLogs[dateStr];
    }

    // Toggle boolean flags
    function toggleDailyFlag(key) {
      const log = getDayLog(selectedDateStr);
      log[key] = !log[key];
      saveState();
      renderAll();
      if (log.steps && log.rice && (key === 'steps' || key === 'rice')) {
        showToast('🎉 今日基礎 KPI 完美達標 (+1.0 點 / -250 kcal)');
      }
    }

    // Update food swap counter
    function updateSwapCount(key, delta) {
      const log = getDayLog(selectedDateStr);
      const next = Math.max(0, (log[key] || 0) + delta);
      log[key] = next;
      saveState();
      renderAll();
      if (delta > 0) {
        if (key === 'poke') showToast('🥗 波奇碗健康爆擊！+1.5 點 (-380 kcal)');
        if (key === 'bento') showToast('🍱 減油便當替換！+1.2 點 (-300 kcal)');
        if (key === 'drink') showToast('🍵 飲品/快走微調！+0.5 點 (-125 kcal)');
      }
    }

    // Shift selected date
    function shiftDate(days) {
      const [y, m, d] = selectedDateStr.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      dt.setDate(dt.getDate() + days);
      selectedDateStr = formatDateStr(dt);
      renderAll();
    }

    function selectDate(dateStr) {
      selectedDateStr = dateStr;
      renderAll();
    }

    function selectToday() {
      selectedDateStr = formatDateStr(new Date());
      renderAll();
    }

    // Render Header & Daily Tab
    function renderDailyTab() {
      // 1. Calculate Total Points across all logs
      let totalPts = 0;
      Object.values(state.dailyLogs).forEach(l => {
        totalPts += calcDayPoints(l);
      });
      totalPts = Math.round(totalPts * 100) / 100;
      const totalKcal = Math.round(totalPts * 250);
      const estFatLost = (totalKcal / 7700).toFixed(2);

      // Calculate Current Week number from startDate
      const [sy, sm, sd] = state.startDate.split('-').map(Number);
      const startDt = new Date(sy, sm - 1, sd);
      const nowDt = new Date();
      const diffDays = Math.max(0, Math.floor((nowDt - startDt) / (1000 * 60 * 60 * 24)));
      const currentWeekNum = Math.min(12, Math.floor(diffDays / 7) + 1);

      document.getElementById('header-week-badge').textContent = `WEEK ${currentWeekNum} / 12`;
      document.getElementById('header-fat-lost').textContent = estFatLost;
      document.getElementById('header-total-kcal').textContent = totalKcal.toLocaleString();
      document.getElementById('header-total-pts').textContent = totalPts.toFixed(1);
      const totalPct = Math.min(100, (totalKcal / 21000) * 100);
      document.getElementById('header-total-bar').style.width = `${totalPct}%`;
      document.getElementById('setting-start-date').textContent = state.startDate;

      // 2. Weekly Score for the selectedDateStr's week
      const weekDates = getWeekDateStrings(selectedDateStr);
      let weekPts = 0;
      weekDates.forEach(dStr => {
        weekPts += calcDayPoints(state.dailyLogs[dStr]);
      });
      weekPts = Math.round(weekPts * 100) / 100;
      const weekKcal = Math.round(weekPts * 250);

      document.getElementById('weekly-pts-display').textContent = weekPts.toFixed(2).replace(/\.00$/, '.0');
      document.getElementById('weekly-kcal-display').textContent = `(-${weekKcal} kcal)`;
      const weekPct = Math.min(100, (weekPts / 7.0) * 100);
      document.getElementById('weekly-pts-bar').style.width = `${weekPct}%`;

      const badge = document.getElementById('weekly-status-badge');
      const bankText = document.getElementById('smart-bank-text');
      if (weekPts >= 7.0) {
        const surplus = (weekPts - 7.0).toFixed(1);
        badge.textContent = '本週達標 🎉';
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-sage/20 text-sage border border-sage/40';
        bankText.innerHTML = `本週已滿 7 點並超額 <strong class="text-sage">+${surplus} 點</strong>！週末聚餐可安心享受一頓好料，或將額度留作加速減脂進度。`;
      } else if (weekPts >= 4.5) {
        const remain = (7.0 - weekPts).toFixed(1);
        badge.textContent = '進度穩定 🔥';
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-accent/20 text-accentLight border border-accent/40';
        bankText.innerHTML = `距離本週目標還差 <strong class="text-white">${remain} 點</strong>。只要維持平日步數與減半碗飯，或來一次「波奇碗替換 (+1.5點)」就能輕鬆達標！`;
      } else {
        const remain = (7.0 - weekPts).toFixed(1);
        badge.textContent = `尚差 ${remain} 點`;
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-zinc-800 text-zinc-300 border border-zinc-700';
        bankText.innerHTML = `每天完成「步數+減半碗飯」即得 1 點。若外食改吃波奇碗可直接賺 <strong class="text-accentLight">+1.5 點</strong> 抵免 3 頓減飯！`;
      }

      // 3. Render 7-Day Strip
      const dayNames = ['一', '二', '三', '四', '五', '六', '日'];
      const stripEl = document.getElementById('week-day-strip');
      stripEl.innerHTML = '';
      weekDates.forEach((dStr, idx) => {
        const isSelected = dStr === selectedDateStr;
        const isToday = dStr === formatDateStr(new Date());
        const pts = calcDayPoints(state.dailyLogs[dStr]);
        const dayNum = dStr.split('-')[2];

        const btn = document.createElement('button');
        btn.onclick = () => selectDate(dStr);
        btn.className = `py-1.5 rounded-xl flex flex-col items-center justify-center transition border ${
          isSelected
            ? 'bg-accent text-white border-accent shadow-md'
            : isToday
            ? 'bg-zinc-800/90 text-zinc-100 border-zinc-600'
            : 'bg-zinc-900/50 text-zinc-400 border-transparent hover:bg-zinc-800/50'
        }`;

        let dotColor = 'bg-zinc-700';
        if (pts >= 1.0) dotColor = isSelected ? 'bg-white' : 'bg-sage';
        else if (pts > 0) dotColor = isSelected ? 'bg-amber-200' : 'bg-accentLight';

        btn.innerHTML = `
          <span class="text-[10px] opacity-80">${dayNames[idx]}</span>
          <span class="text-xs font-mono font-bold mt-0.5">${dayNum}</span>
          <span class="w-1.5 h-1.5 rounded-full mt-1 ${dotColor}"></span>
        `;
        stripEl.appendChild(btn);
      });

      const realToday = formatDateStr(new Date());
      document.getElementById('selected-date-label').textContent =
        selectedDateStr === realToday ? `今天 (${selectedDateStr})` : `檢視日期：${selectedDateStr}`;
      document.getElementById('btn-back-today').classList.toggle('hidden', selectedDateStr === realToday);

      // 4. Render Selected Day Toggles
      const log = getDayLog(selectedDateStr);
      const basePts = (log.steps ? 0.45 : 0) + (log.rice ? 0.55 : 0);
      const dayTotalPts = calcDayPoints(log);
      document.getElementById('daily-base-status').textContent = `當日合計 +${dayTotalPts.toFixed(2).replace(/\.00$/, '.0')} pt (-${Math.round(dayTotalPts * 250)} kcal)`;

      // Steps UI
      const stepsCard = document.getElementById('card-kpi-steps');
      const stepsCheck = document.getElementById('check-kpi-steps');
      const stepsIcon = document.getElementById('icon-kpi-steps');
      if (log.steps) {
        stepsCard.className = 'w-full text-left bg-accent/15 active:scale-[0.99] transition-all rounded-2xl p-3.5 border border-accent flex items-center justify-between';
        stepsCheck.className = 'w-6 h-6 rounded-full bg-accent border-2 border-accent flex items-center justify-center transition-all';
        stepsCheck.querySelector('svg').classList.remove('opacity-0');
        stepsIcon.className = 'w-11 h-11 rounded-xl bg-accent/20 flex items-center justify-center text-xl border border-accent/40';
      } else {
        stepsCard.className = 'w-full text-left bg-bgCard hover:bg-bgElevated active:scale-[0.99] transition-all rounded-2xl p-3.5 border border-borderSubtle flex items-center justify-between';
        stepsCheck.className = 'w-6 h-6 rounded-full border-2 border-zinc-600 flex items-center justify-center transition-all';
        stepsCheck.querySelector('svg').classList.add('opacity-0');
        stepsIcon.className = 'w-11 h-11 rounded-xl bg-zinc-800 flex items-center justify-center text-xl border border-zinc-700';
      }

      // Rice UI
      const riceCard = document.getElementById('card-kpi-rice');
      const riceCheck = document.getElementById('check-kpi-rice');
      const riceIcon = document.getElementById('icon-kpi-rice');
      if (log.rice) {
        riceCard.className = 'w-full text-left bg-accent/15 active:scale-[0.99] transition-all rounded-2xl p-3.5 border border-accent flex items-center justify-between';
        riceCheck.className = 'w-6 h-6 rounded-full bg-accent border-2 border-accent flex items-center justify-center transition-all';
        riceCheck.querySelector('svg').classList.remove('opacity-0');
        riceIcon.className = 'w-11 h-11 rounded-xl bg-accent/20 flex items-center justify-center text-xl border border-accent/40';
      } else {
        riceCard.className = 'w-full text-left bg-bgCard hover:bg-bgElevated active:scale-[0.99] transition-all rounded-2xl p-3.5 border border-borderSubtle flex items-center justify-between';
        riceCheck.className = 'w-6 h-6 rounded-full border-2 border-zinc-600 flex items-center justify-center transition-all';
        riceCheck.querySelector('svg').classList.add('opacity-0');
        riceIcon.className = 'w-11 h-11 rounded-xl bg-zinc-800 flex items-center justify-center text-xl border border-zinc-700';
      }

      // Swaps UI
      document.getElementById('count-swap-poke').textContent = log.poke || 0;
      document.getElementById('count-swap-bento').textContent = log.bento || 0;
      document.getElementById('count-swap-drink').textContent = log.drink || 0;

      // Muscle Retention Shield UI
      const workoutCard = document.getElementById('card-shield-workout');
      const workoutDot = document.getElementById('dot-shield-workout');
      if (log.workout) {
        workoutCard.className = 'p-3 rounded-2xl bg-sage/15 border border-sage text-left transition-all flex flex-col justify-between h-24';
        workoutDot.className = 'w-4 h-4 rounded-full bg-sage border border-sage flex items-center justify-center';
        workoutDot.innerHTML = '<svg class="w-2.5 h-2.5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"/></svg>';
      } else {
        workoutCard.className = 'p-3 rounded-2xl bg-bgCard border border-borderSubtle text-left transition-all flex flex-col justify-between h-24';
        workoutDot.className = 'w-4 h-4 rounded-full border border-zinc-600 flex items-center justify-center';
        workoutDot.innerHTML = '';
      }

      const proteinCard = document.getElementById('card-shield-protein');
      const proteinDot = document.getElementById('dot-shield-protein');
      if (log.protein) {
        proteinCard.className = 'p-3 rounded-2xl bg-sage/15 border border-sage text-left transition-all flex flex-col justify-between h-24';
        proteinDot.className = 'w-4 h-4 rounded-full bg-sage border border-sage flex items-center justify-center';
        proteinDot.innerHTML = '<svg class="w-2.5 h-2.5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"/></svg>';
      } else {
        proteinCard.className = 'p-3 rounded-2xl bg-bgCard border border-borderSubtle text-left transition-all flex flex-col justify-between h-24';
        proteinDot.className = 'w-4 h-4 rounded-full border border-zinc-600 flex items-center justify-center';
        proteinDot.innerHTML = '';
      }
    }

    // Add Body Stat Entry
    function addBodyStat() {
      const dateVal = document.getElementById('input-stat-date').value || formatDateStr(new Date());
      const weightVal = parseFloat(document.getElementById('input-stat-weight').value);
      const bfInput = parseFloat(document.getElementById('input-stat-bf').value);
      const waistInput = parseFloat(document.getElementById('input-stat-waist').value);

      if (isNaN(weightVal) || weightVal < 40 || weightVal > 150) {
        showToast('請輸入有效的體重數值');
        return;
      }

      // Sort existing logs to get latest fallback for optional BF% and Waist
      const sorted = [...state.bodyLogs].sort((a, b) => a.date.localeCompare(b.date));
      const lastEntry = sorted[sorted.length - 1] || { bf: 22.4, waist: 77.0 };

      const newEntry = {
        date: dateVal,
        weight: Math.round(weightVal * 10) / 10,
        bf: !isNaN(bfInput) ? Math.round(bfInput * 10) / 10 : lastEntry.bf,
        waist: !isNaN(waistInput) ? Math.round(waistInput * 10) / 10 : lastEntry.waist
      };

      // Replace if same date exists, otherwise push
      const existingIdx = state.bodyLogs.findIndex(item => item.date === dateVal);
      if (existingIdx >= 0) {
        state.bodyLogs[existingIdx] = newEntry;
      } else {
        state.bodyLogs.push(newEntry);
      }

      state.bodyLogs.sort((a, b) => a.date.localeCompare(b.date));
      saveState();
      renderStatsTab();
      showToast('✅ 體態數據已更新！');
    }

    function deleteBodyStat(dateStr) {
      if (state.bodyLogs.length <= 1) {
        showToast('需至少保留一筆基準紀錄');
        return;
      }
      state.bodyLogs = state.bodyLogs.filter(item => item.date !== dateStr);
      saveState();
      renderStatsTab();
      showToast('已刪除該筆紀錄');
    }

    // Render Stats & LBM Guardrail Tab
    function renderStatsTab() {
      const sorted = [...state.bodyLogs].sort((a, b) => a.date.localeCompare(b.date));
      const latest = sorted[sorted.length - 1];

      // Pre-fill inputs with latest values as placeholders
      const dateInput = document.getElementById('input-stat-date');
      if (!dateInput.value) dateInput.value = formatDateStr(new Date());
      document.getElementById('input-stat-weight').placeholder = latest.weight.toFixed(1);
      document.getElementById('input-stat-bf').placeholder = latest.bf.toFixed(1);
      document.getElementById('input-stat-waist').placeholder = latest.waist.toFixed(1);

      // Calculate LBM & Fat Mass
      const fatMass = +(latest.weight * (latest.bf / 100)).toFixed(1);
      const lbm = +(latest.weight - fatMass).toFixed(1);

      // Calculate 7-entry moving average weight
      const recentSlice = sorted.slice(-7);
      const avgWeight = +(recentSlice.reduce((acc, cur) => acc + cur.weight, 0) / recentSlice.length).toFixed(1);

      document.getElementById('stat-current-lbm').innerHTML = `${lbm.toFixed(1)} <span class="text-xs font-normal text-zinc-400">kg</span>`;
      document.getElementById('stat-current-fatmass').innerHTML = `${fatMass.toFixed(1)} <span class="text-xs font-normal text-zinc-400">kg</span>`;
      document.getElementById('stat-moving-avg').innerHTML = `${avgWeight.toFixed(1)} <span class="text-xs font-normal text-zinc-400">kg</span>`;

      // LBM Guardrail Alert
      const alertCard = document.getElementById('lbm-alert-card');
      const feedbackEl = document.getElementById('lbm-feedback-text');
      if (lbm >= 53.0) {
        alertCard.className = 'bg-bgCard rounded-2xl p-4 border border-sage/50 shadow-lg';
        feedbackEl.innerHTML = `✅ <strong>保肌狀態極佳！</strong>除脂體重維持在 <span class="text-sage font-mono font-bold">${lbm} kg</span>，減去的體重幾乎全數來自純脂肪。`;
      } else if (lbm >= 52.6) {
        alertCard.className = 'bg-bgCard rounded-2xl p-4 border border-amber-500/50 shadow-lg';
        feedbackEl.innerHTML = `⚠️ <strong>輕微水分或肝醣波動：</strong>除脂體重為 <span class="text-amber-300 font-mono font-bold">${lbm} kg</span>。請確保練後碳水與每日蛋白質 (125g+) 充足。`;
      } else {
        alertCard.className = 'bg-bgCard rounded-2xl p-4 border border-red-500/60 shadow-lg';
        feedbackEl.innerHTML = `🚨 <strong>掉肌警報：</strong>除脂體重降至 <span class="text-red-400 font-mono font-bold">${lbm} kg</span>。建議本週午餐恢復正常飯量、睡滿 7.5 小時，並嚴禁降低重訓重量！`;
      }

      // Progress Bars toward 12-week targets
      document.getElementById('bar-label-weight').textContent = `${latest.weight.toFixed(1)} kg`;
      const weightPct = Math.max(4, Math.min(100, ((BASELINE.startWeight - latest.weight) / (BASELINE.startWeight - BASELINE.targetWeight)) * 100));
      document.getElementById('bar-prog-weight').style.width = `${weightPct}%`;

      document.getElementById('bar-label-bf').textContent = `${latest.bf.toFixed(1)} %`;
      const bfPct = Math.max(4, Math.min(100, ((BASELINE.startBF - latest.bf) / (BASELINE.startBF - BASELINE.targetBF)) * 100));
      document.getElementById('bar-prog-bf').style.width = `${bfPct}%`;

      document.getElementById('bar-label-waist').textContent = `${latest.waist.toFixed(1)} cm`;
      const waistPct = Math.max(4, Math.min(100, ((BASELINE.startWaist - latest.waist) / (BASELINE.startWaist - BASELINE.targetWaist)) * 100));
      document.getElementById('bar-prog-waist').style.width = `${waistPct}%`;

      // Render SVG Chart
      renderWeightChart(sorted);

      // Render History List (Newest first)
      const listEl = document.getElementById('body-log-list');
      listEl.innerHTML = '';
      [...sorted].reverse().forEach(item => {
        const itemFat = +(item.weight * (item.bf / 100)).toFixed(1);
        const itemLbm = +(item.weight - itemFat).toFixed(1);
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between p-2.5 rounded-xl bg-zinc-900/70 border border-zinc-800 text-xs';
        row.innerHTML = `
          <div>
            <span class="font-mono font-bold text-zinc-200">${item.date}</span>
            <div class="text-[11px] text-zinc-400 mt-0.5">
              除脂體重 <strong class="text-sage font-mono">${itemLbm}kg</strong> ｜ 腰圍 <span class="font-mono">${item.waist}cm</span>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="text-right font-mono">
              <div class="font-bold text-white">${item.weight.toFixed(1)} kg</div>
              <div class="text-[11px] text-accentLight">${item.bf.toFixed(1)}%</div>
            </div>
            <button onclick="deleteBodyStat('${item.date}')" class="text-zinc-500 hover:text-red-400 p-1">✕</button>
          </div>
        `;
        listEl.appendChild(row);
      });
    }

    // Simple Responsive SVG Line Chart for Weight
    function renderWeightChart(sortedLogs) {
      const container = document.getElementById('svg-chart-container');
      const pts = sortedLogs.slice(-10); // show up to last 10 points
      const w = 320, h = 110, padX = 24, padY = 18;

      const minW = Math.min(65.0, ...pts.map(p => p.weight)) - 0.4;
      const maxW = Math.max(69.0, ...pts.map(p => p.weight)) + 0.4;

      const getX = (i) => pts.length === 1 ? w / 2 : padX + (i / (pts.length - 1)) * (w - padX * 2);
      const getY = (val) => h - padY - ((val - minW) / (maxW - minW)) * (h - padY * 2);

      const targetY = getY(BASELINE.targetWeight);
      let pathD = '';
      let circles = '';

      pts.forEach((p, idx) => {
        const cx = getX(idx);
        const cy = getY(p.weight);
        pathD += idx === 0 ? `M ${cx} ${cy}` : ` L ${cx} ${cy}`;
        circles += `
          <circle cx="${cx}" cy="${cy}" r="3.5" fill="#E07A5F" stroke="#121214" stroke-width="1.5" />
          <text x="${cx}" y="${cy - 7}" fill="#D4D4D8" font-size="9" font-family="JetBrains Mono" text-anchor="middle">${p.weight}</text>
        `;
      });

      container.innerHTML = `
        <svg viewBox="0 0 ${w} ${h}" class="w-full h-full overflow-visible">
          <!-- Target Weight Dashed Line (65.7kg) -->
          <line x1="${padX}" y1="${targetY}" x2="${w - padX}" y2="${targetY}" stroke="#52B788" stroke-width="1" stroke-dasharray="4 3" opacity="0.7" />
          <text x="${w - padX}" y="${targetY - 4}" fill="#52B788" font-size="8" font-family="JetBrains Mono" text-anchor="end">目標 65.7kg</text>
          
          <!-- Weight Line -->
          ${pts.length > 1 ? `<path d="${pathD}" fill="none" stroke="#E07A5F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />` : ''}
          ${circles}
        </svg>
      `;
    }

    // Tab Switching
    function switchTab(tabName) {
      ['daily', 'stats', 'guide'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.toggle('hidden', t !== tabName);
        const btn = document.getElementById(`nav-btn-${t}`);
        if (t === tabName) {
          btn.className = 'flex flex-col items-center gap-1 text-accent transition';
        } else {
          btn.className = 'flex flex-col items-center gap-1 text-zinc-500 hover:text-zinc-300 transition';
        }
      });
      if (tabName === 'stats') renderStatsTab();
    }

    // Modals for Start Date & Data Backup
    function openStartDateModal() {
      const overlay = document.getElementById('modal-overlay');
      document.getElementById('modal-title').textContent = '設定 12 週計畫開跑日期';
      document.getElementById('modal-body').innerHTML = `
        <p class="text-xs text-zinc-400 mb-2">系統會根據開跑日自動計算目前處於第幾週 (Week 1 ~ 12)：</p>
        <input type="date" id="modal-input-startdate" value="${state.startDate}" class="w-full bg-zinc-900 border border-zinc-700 rounded-xl px-3 py-2 text-sm text-white font-mono" />
      `;
      const confirmBtn = document.getElementById('modal-confirm-btn');
      confirmBtn.onclick = () => {
        const val = document.getElementById('modal-input-startdate').value;
        if (val) {
          state.startDate = val;
          saveState();
          renderAll();
          closeModal();
          showToast('已更新計畫開跑日');
        }
      };
      overlay.classList.remove('hidden');
    }

    function exportData() {
      const jsonStr = JSON.stringify(state);
      const tempArea = document.createElement('textarea');
      tempArea.value = jsonStr;
      document.body.appendChild(tempArea);
      tempArea.select();
      try {
        document.execCommand('copy');
        showToast('📋 備份代碼已複製到剪貼簿！');
      } catch (err) {
        showToast('複製失敗，請手動備份');
      }
      document.body.removeChild(tempArea);
    }

    function openImportModal() {
      const overlay = document.getElementById('modal-overlay');
      document.getElementById('modal-title').textContent = '還原備份資料';
      document.getElementById('modal-body').innerHTML = `
        <p class="text-xs text-zinc-400 mb-2">請貼上先前複製的 JSON 備份代碼：</p>
        <textarea id="modal-input-json" rows="4" placeholder='{"startDate":...}' class="w-full bg-zinc-900 border border-zinc-700 rounded-xl p-2.5 text-xs text-white font-mono"></textarea>
      `;
      const confirmBtn = document.getElementById('modal-confirm-btn');
      confirmBtn.onclick = () => {
        const raw = document.getElementById('modal-input-json').value.trim();
        try {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.dailyLogs && parsed.bodyLogs) {
            state = parsed;
            saveState();
            renderAll();
            closeModal();
            showToast('✅ 備份資料還原成功！');
          } else {
            showToast('❌ 格式不正確');
          }
        } catch (e) {
          showToast('❌ 無法解析備份碼');
        }
      };
      overlay.classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('modal-overlay').classList.add('hidden');
    }

    function renderAll() {
      renderDailyTab();
      renderStatsTab();
    }

    // Initialize App on Load
    window.onload = function () {
      loadState();
      renderAll();
    };
  </script>
</body>
